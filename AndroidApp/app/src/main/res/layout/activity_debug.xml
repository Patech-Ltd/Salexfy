<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary_dark"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Debug &amp; Logs"
        app:titleTextColor="@color/white" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/crash_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_crashes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Clear crash list" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_log"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Clear log file" />
    </LinearLayout>

    <TextView
        android:id="@+id/log_view"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/dark_bg"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:textColor="@color/dark_text_primary"
        android:textIsSelectable="true"
        android:textSize="11sp" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_debug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:text="Debug mode (extra logging)" />

</LinearLayout>
