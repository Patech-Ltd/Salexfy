<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />


    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".SalexfyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SalexfyPos">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SalexfyPos">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.login.SetupActivity"
            android:exported="false" />
        <activity
            android:name=".ui.products.ProductEditActivity"
            android:exported="false" />
        <activity
            android:name=".ui.products.BatchAddProductsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.products.CategoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.products.BrandActivity"
            android:exported="false" />
        <activity
            android:name=".ui.products.UnitActivity"
            android:exported="false" />
        <activity
            android:name=".ui.sell.SaleDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.sell.SalesHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.sell.PaymentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.sell.ManualSaleActivity"
            android:exported="false" />
        <activity
            android:name=".ui.stock.PurchaseEditActivity"
            android:exported="false" />
        <activity
            android:name=".ui.stock.StockTakeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.suppliers.SupplierEditActivity"
            android:exported="false" />
        <activity
            android:name=".ui.suppliers.SupplierListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.suppliers.CustomerEditActivity"
            android:exported="false" />
        <activity
            android:name=".ui.suppliers.CustomerListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.suppliers.CustomerDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.reports.ReportsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.users.UserEditActivity"
            android:exported="false" />
        <activity
            android:name=".ui.users.UserListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.users.RoleActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.BusinessSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.ScannerSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.PrinterSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.LoyaltySettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.BackupSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SyncSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.SyncLogActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.DebugActivity"
            android:exported="false" />
        <activity
            android:name=".ui.scan.ScanActivity"
            android:exported="false"
            android:theme="@style/Theme.SalexfyPos" />
        <activity
            android:name=".ui.help.HelpActivity"
            android:exported="false" />
        <activity
            android:name=".ui.crash.CrashRecoveryActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
